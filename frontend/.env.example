# Portal VETNEB — Frontend
# Copiar este archivo a .env.local y completar los valores reales.
# No commitear secretos reales.

# URL del backend Fastify (sin trailing slash) — obligatorio en producción.
NEXT_PUBLIC_API_URL=https://api.vetneb.com.ar

# URL pública del frontend (SEO, canonical, sitemap) — obligatorio en producción.
NEXT_PUBLIC_SITE_URL=https://vetneb.com.ar

# Version gate. Build-time: requiere rebuild del frontend al cambiar.
# Debe usar el mismo token no secreto que APP_VERSION/CLIENT_MIN_VERSION del backend.
NEXT_PUBLIC_APP_VERSION=<version-token>

# Solo desarrollo local (auxiliar)
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3001

# SEC-10 (opt-in, solo servidor; NUNCA NEXT_PUBLIC_*): el proxy de Next firma la IP del
# cliente para el backend en /api/*. Sin estas dos variables no se firma nada.
# CLIENT_IP_SIGNING_SECRET debe ser idéntico al del backend (>= 32 caracteres).
# CLIENT_IP_EDGE_CIDRS: rangos de borde publicados y acotados (IPv4 >= /8, IPv6 >= /16);
# sin valor por defecto. No activar hasta validar la topología en staging (E4).
# CLIENT_IP_SIGNING_SECRET=<RANDOM_SECRET_32_CHARS_MIN>
# CLIENT_IP_EDGE_CIDRS=<PUBLISHED_EDGE_CIDRS>
