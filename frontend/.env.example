# Portal VETNEB — Frontend
# Copiar este archivo a .env.local y completar los valores reales

# URL del backend Fastify (sin trailing slash)
# En desarrollo local: http://localhost:3000
# En LAN local: http://<LAN-IP>:3000
# En staging Render: https://<backend-staging>.onrender.com
# En producción: https://tu-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL pública del frontend (para SEO, canonical URLs, sitemap)
# En desarrollo: http://localhost:3001
# En LAN local: http://<LAN-IP>:3001
# En producción: https://portal.vetneb.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
