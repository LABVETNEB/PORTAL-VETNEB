{
  "name": "portal-vetneb-backend",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "tsx server/index.ts",
    "admin:open": "powershell -ExecutionPolicy Bypass -File scripts/dev/open-admin-dashboard.ps1",
    "build": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p ./test/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "smoke:test": "node scripts/smoke/smoke-test.mjs",
    "smoke:upload": "node scripts/smoke/smoke-upload.mjs",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test test/**/*.test.ts",
    "validate:local": "pnpm typecheck && pnpm typecheck:test && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "argon2": "^0.44.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
      "esbuild@<=0.24.2": "0.25.0",
      "fast-uri@<=3.1.1": "3.1.2",
      "postcss@<8.5.10": "8.5.14",
      "ws@>=8.0.0 <8.20.1": "8.20.1"
    }
  }
}
